# ─── Required ───────────────────────────────────────────────
# Password the doctor uses to sign in at /admin/login
ADMIN_PASSWORD=

# ─── Optional ───────────────────────────────────────────────
# Name shown in the dashboard greeting and on bookings ("د. أحمد")
ADMIN_NAME=

# Extra staff accounts, e.g. a receptionist:  Name:password;Name2:password2
STAFF_USERS=

# Clinic timezone (also editable in Settings). Default: Africa/Algiers
CLINIC_TIMEZONE=Africa/Algiers

# Fixed session secret. Leave empty: one is generated and stored privately in the database.
SESSION_SECRET=

# ─── Storage (Supabase) ─────────────────────────────────────
# From Supabase → Project Settings → API Keys. Use the SECRET key (sb_secret_…), never the publishable one,
# and never give the secret key a NEXT_PUBLIC_ prefix. Create the table first with supabase/schema.sql.
# Without them: locally the app uses .data/db.json; on Vercel it runs read-only with a warning.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SECRET_KEY=

# ─── Local preview only ─────────────────────────────────────
# DATA_FILE=<path> makes the app use that local JSON file instead of Supabase (safe place to experiment)
# DATA_FILE=.data/test.json
# SEED_DEMO=1 fills a NEW local file database with sample patients (never Supabase, ignored in production)
# SEED_DEMO=1
